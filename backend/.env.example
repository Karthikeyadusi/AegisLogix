# ---------------------------------------------------------------------------
# AegisLogix Environment Variable Template
# ---------------------------------------------------------------------------
# Rename this file to .env and place it in the backend/ directory to 
# override default settings during local development.
# 
# Pydantic Settings will automatically map these AEGIS_* variables 
# to the Settings class fields.
# ---------------------------------------------------------------------------

# Port for Uvicorn/Gunicorn to bind to (default: 10000)
# AEGIS_PORT=10000

# Number of worker processes (default: 1)
# AEGIS_WORKERS=1

# Application log level: debug, info, warning, error (default: info)
# AEGIS_LOG_LEVEL=info

# Model confidence threshold for detections (default: 0.40)
# AEGIS_CONFIDENCE_THRESHOLD=0.40

# Comma-separated list of allowed CORS origins
# AEGIS_ALLOWED_ORIGINS=["http://localhost:5173", "https://your-domain.com"]

# Path to the ONNX model file (default: backend/models/aegis_v1.onnx)
# AEGIS_ONNX_MODEL_PATH=models/aegis_v1.onnx
